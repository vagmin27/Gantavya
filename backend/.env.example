# Server Configuration
NODE_ENV=development
PORT=5000

# Client Configuration (CORS & Cookie Domain)
CLIENT_URL=http://localhost:5173

# Database (MongoDB Primary Connection)
MONGODB_URI=mongodb://localhost:27017/gantavya

# Authentication & Security
JWT_SECRET=replace_with_a_secure_jwt_secret_min_32_chars
JWT_ACCESS_SECRET=replace_with_a_secure_access_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_secure_refresh_secret_min_32_chars
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_a_secure_cookie_secret_min_32_chars
COOKIE_SAME_SITE=lax

# Intelligence Service Communication
INTELLIGENCE_SERVICE_URL=http://localhost:8000/api/v1
INTERNAL_SERVICE_KEY=replace_with_an_internal_service_key

# External Transportation Providers (Optional in Development)
# HERE Routing v8 API Key for road travel, traffic and tolls
HERE_API_KEY=
HERE_ROUTING_BASE_URL=https://router.hereapi.com/v8

# Amadeus Self-Service Flight Offers API Credentials
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_HOSTNAME=test.api.amadeus.com
